{
  // Il debugger avvia direttamente la dll, quindi NON legge Properties/launchSettings.json
  // (quello vale solo per "dotnet run"). Ambiente e porte vanno dichiarati qui, ed e' il
  // motivo per cui la porta 7194 e' ripetuta: e' quella registrata come redirect URI su
  // Entra ID, e cambiarla romperebbe l'accesso.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Avvia MesDataManager.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MesDataManager.Web/bin/Debug/net10.0/MesDataManager.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MesDataManager.Web",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7194;http://localhost:5194"
      },
      // Apre il browser quando Kestrel dichiara di essere in ascolto.
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Collega a un processo in esecuzione",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
