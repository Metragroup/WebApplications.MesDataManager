{
  "DetailedErrors": true,

  // Autenticazione saltata in locale: nessun tenant Entra ID necessario.
  // Passare a "EntraId" quando la registrazione applicativa e' pronta.
  // Ridurre "Roles" per verificare i permessi: solo "Reader" da la sola consultazione,
  // un array vuoto fa negare l'accesso.
  "Authentication": {
    "Mode": "Development",
    "DevelopmentUser": {
      "UserName": "sviluppatore.locale",
      "DisplayName": "Utente di sviluppo",
      "Roles": [ "Administrator", "Archive.Editor", "Production.Editor" ]
    }
  },

  // Il servizio di diagnostica sta sulla rete di stabilimento: in locale funziona se la
  // postazione ci arriva, altrimenti la diagnostica risponde con un messaggio e non con un
  // ripiego — le regole locali del vecchio applicativo non sono state riportate.
  "Diagnostics": {
    "BaseUrl": "http://192.168.3.8:8000/api/v1/batches/",
    "TimeoutSeconds": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
