{
  "DetailedErrors": true,

  // Autenticazione saltata in locale: nessun tenant Entra ID necessario.
  // Passare a "EntraId" quando la registrazione applicativa e' pronta.
  // Ridurre "Roles" per verificare i permessi: solo "Reader" da la sola consultazione,
  // un array vuoto fa negare l'accesso.
  "Authentication": {
    "Mode": "Development",
    "DevelopmentUser": {
      "UserName": "sviluppatore.locale",
      "DisplayName": "Utente di sviluppo",
      "Roles": [ "Administrator", "Archive.Editor", "Production.Editor" ]
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
