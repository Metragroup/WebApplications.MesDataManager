@inject IStringLocalizer<Strings> L

@*
    Due comandi che chiedono la stessa cosa in modo diverso:

    - duplica billetta (FrmDuplicateBillet): quante copie, da quale numero, e in che intervallo
      distribuirle;
    - rinumera billette (frmRenumberBillet): da quale numero ripartire, sulle righe selezionate.

    Le date compaiono solo per la duplicazione: rinumerare non sposta niente nel tempo.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@Hint</MudText>

        <MudGrid Spacing="2">
            <MudItem xs="6" sm="4">
                <MudNumericField T="int" @bind-Value="_count"
                                 @bind-Value:after="RecomputeTo"
                                 Label="@L["Field.BilletsToAdd"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="1" Max="500"
                                 ReadOnly="@(Mode == BilletRangeMode.Renumber)" />
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudNumericField T="short" @bind-Value="_fromNo"
                                 @bind-Value:after="RecomputeTo"
                                 Label="@L["Field.BilletFrom"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudTextField T="string" Value="@_toNo.ToString(CultureInfo.InvariantCulture)"
                              Label="@L["Field.BilletTo"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
            </MudItem>

            @if (Mode == BilletRangeMode.Duplicate)
            {
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="_fromDate" DateChanged="@(d => _fromDate = d ?? _fromDate)"
                                   Label="@L["Field.BatchStart"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" Clearable="false" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Time="_fromTime" TimeChanged="@(t => _fromTime = t ?? _fromTime)"
                                   Label="@L["Field.BatchStart"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" Clearable="false" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="_toDate" DateChanged="@(d => _toDate = d ?? _toDate)"
                                   Label="@L["Field.BatchStop"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" Clearable="false" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Time="_toTime" TimeChanged="@(t => _toTime = t ?? _toTime)"
                                   Label="@L["Field.BatchStop"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" Clearable="false" />
                </MudItem>
            }
        </MudGrid>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-4">
                @_error
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@L["Action.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public BilletRangeMode Mode { get; set; }

    /// <summary>Quante righe sono coinvolte: fisso per la rinumerazione, proposto per la copia.</summary>
    [Parameter]
    public int InitialCount { get; set; } = 1;

    [Parameter]
    public short InitialFromNo { get; set; } = 1;

    /// <summary>Istante da cui partire nella duplicazione: la fine della billetta di origine.</summary>
    [Parameter]
    public DateTime? InitialFrom { get; set; }

    private int _count = 1;
    private short _fromNo = 1;
    private short _toNo = 1;

    private DateTime _fromDate = DateTime.Today;
    private TimeSpan _fromTime = TimeSpan.Zero;
    private DateTime _toDate = DateTime.Today;
    private TimeSpan _toTime = TimeSpan.Zero;

    private string? _error;

    private string Title => Mode == BilletRangeMode.Duplicate
        ? L["Msg.DuplicateBilletTitle"]
        : L["Msg.RenumberBilletsTitle"];

    private string Hint => Mode == BilletRangeMode.Duplicate
        ? L["Msg.DuplicateBilletHint"]
        : L["Msg.RenumberBilletsHint", InitialCount];

    private string ConfirmText => Mode == BilletRangeMode.Duplicate
        ? L["Action.Add"]
        : L["Action.Renumber"];

    protected override void OnInitialized()
    {
        _count = Math.Max(InitialCount, 1);
        _fromNo = InitialFromNo;
        RecomputeTo();

        var start = InitialFrom ?? DateTime.Now;
        _fromDate = start.Date;
        _fromTime = start.TimeOfDay;
        _toDate = start.Date;
        _toTime = start.TimeOfDay;
    }

    private void RecomputeTo() => _toNo = (short)(_fromNo + Math.Max(_count, 1) - 1);

    private void Confirm()
    {
        var from = _fromDate.Date + _fromTime;
        var to = _toDate.Date + _toTime;

        if (Mode == BilletRangeMode.Duplicate && to < from)
        {
            _error = L["Error.PeriodInvalid"];
            return;
        }

        Dialog.Close(DialogResult.Ok(new BilletRangeResult(_count, _fromNo, from, to)));
    }

    private void Cancel() => Dialog.Cancel();
}
