@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation
@inject IUserContext User
@inject IConfiguration Configuration

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Medium" FullWidth="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="@L["Nav.Archives"]"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-2">@L["App.Title"]</MudText>

        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Tema chiaro" : "Tema scuro")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@(() => _isDarkMode = !_isDarkMode)" />
        </MudTooltip>

        <MudMenu Icon="@Icons.Material.Outlined.Translate"
                 Color="Color.Inherit"
                 AriaLabel="@L["App.Language"]">
            @foreach (var culture in Cultures)
            {
                <MudMenuItem OnClick="@(() => SwitchCulture(culture.Code))">
                    @culture.Label
                    @if (string.Equals(
                        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
                        culture.Code,
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Class="ml-2" />
                    }
                </MudMenuItem>
            }
        </MudMenu>

        @*
            Etichetta e icona sono parametri del menu, non un pulsante dentro ActivatorContent:
            MudButton ferma la propagazione del clic (ClickPropagation e' false per impostazione
            predefinita da MudBlazor 8), quindi il clic non arrivava mai all'attivatore e il
            menu non si apriva. Si vedeva l'animazione del pulsante e nient'altro.
        *@
        <MudMenu Label="@(_user.DisplayName ?? _user.UserName)"
                 StartIcon="@Icons.Material.Outlined.AccountCircle"
                 Variant="Variant.Text"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <ChildContent>
                @* Anche questo indirizzo e' relativo alla base dell'applicazione. La pagina
                   mostra ruoli e permessi di chi la apre: e' il primo posto da guardare quando
                   i permessi non corrispondono a quelli assegnati nel portale. *@
                <MudMenuItem Icon="@Icons.Material.Outlined.Badge"
                             Href="diagnostica/identita">
                    Identità e permessi
                </MudMenuItem>

                @if (Configuration.SupportsSignOut())
                {
                    @* Non un Href: l'uscita e' un endpoint HTTP, non una pagina del router, e
                       un collegamento interno verrebbe intercettato dal router lato client, che
                       non trovando nessuna rotta corrispondente mostrerebbe "pagina non
                       trovata". Serve un ricaricamento vero, come per il cambio lingua. *@
                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOut">
                        @L["Action.SignOut"]
                    </MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.Science" Disabled="true">
                        Autenticazione in modalità sviluppo
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Responsive">
        <MudDrawerHeader Class="mes-drawer__brand">
            @* Il marchio e' anche la via di ritorno all'apertura: e' il primo gesto che si prova. *@
            <a href="@Navigation.BaseUri" class="mes-drawer__home" aria-label="@L["App.Title"]">
                <MetraLogo Class="mes-drawer__logo" />
            </a>
        </MudDrawerHeader>

        <MainNavigation />

        @* In fondo al menu, in grigio: su quale server e su quale database si sta lavorando.
           L'ambiente di prova e quello di esercizio si assomigliano, e saperlo a colpo d'occhio
           evita di correggere i dati sbagliati. *@
        <div class="mes-drawer__database">
            <span>@L["Msg.Server"]: @_database.Server</span>
            <span>@L["Msg.Database"]: @_database.Database</span>
        </div>
    </MudDrawer>

    <MudMainContent Class="mes-main">
        @* Fra il clic su una voce di menu e il primo disegno della pagina nuova puo' passare
           qualche secondo — la pagina interroga il database prima di comparire — e senza un
           segnale l'applicazione sembra bloccata. La barra copre esattamente quell'intervallo. *@
        @if (_navigating)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mes-navigating" />
        }

        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = Theming.MesTheme.Build();

    private static readonly (string Code, string Label)[] Cultures =
    [
        ("it", "Italiano"),
        ("en", "English"),
        ("fr", "Français"),
    ];

    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private UserPermissions _user = UserPermissions.Anonymous;

    private bool _navigating;
    private DatabaseIdentity _database = DatabaseIdentity.Unknown;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _database = DatabaseIdentity.FromConfiguration(Configuration);
        _user = await User.GetCurrentAsync();
    }

    /// <summary>
    /// La navigazione e' cominciata: si accende la barra. Si spegne al primo disegno successivo,
    /// che avviene quando la pagina nuova ha finito di prepararsi.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigating = true;
        InvokeAsync(StateHasChanged);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_navigating)
        {
            _navigating = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;


    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>
    /// Uscita: l'indirizzo e' relativo alla base dell'applicazione — sotto IIS
    /// /mesdatamanager — e il ricaricamento e' necessario perche' da li' si passa al rinvio
    /// verso Entra ID. Vedi l'endpoint in Program.cs.
    /// </summary>
    private void SignOut() =>
        Navigation.NavigateTo(AuthenticationSetup.SignOutPath, forceLoad: true);

    /// <summary>
    /// Il cambio lingua passa da un endpoint HTTP: la cultura del circuito Blazor Server e'
    /// fissata all'avvio, quindi serve un ricaricamento vero della pagina.
    /// </summary>
    private void SwitchCulture(string culture)
    {
        // Entrambi gli indirizzi sono relativi alla base dell'applicazione, non alla radice
        // del server: sotto IIS l'applicazione sta in /MesDataManager, e un "/" iniziale
        // porterebbe l'endpoint fuori dall'applicazione.
        var current = Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = $"culture/set?culture={Uri.EscapeDataString(culture)}" +
                     $"&redirectUri={Uri.EscapeDataString(current)}";

        Navigation.NavigateTo(target, forceLoad: true);
    }
}
