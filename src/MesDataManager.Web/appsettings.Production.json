{
  // Impostazioni di esercizio: itbsintra01.metra.local, applicazione IIS "MesDataManager".
  //
  // Questo file viene incluso nella pubblicazione e quindi SOVRASCRIVE quello sul server a
  // ogni deploy: va compilato qui, in repository, non a mano sulla macchina. Non contiene
  // segreti — la connessione usa l'account di dominio dell'application pool e Entra ID non
  // richiede client secret — quindi puo' stare sotto controllo di versione.

  // COMPILARE: nome dell'istanza SQL Server e del database di esercizio.
  // Integrated Security: accede l'identita' dell'application pool (l'account di servizio
  // di dominio), quindi non c'e' nessuna password da custodire ne' da ruotare.
  "ConnectionStrings": {
    "MesDatabase": "Server=ITBSDB01\\SCADA2014;Database=MES40_RDP;Trusted_Connection=True;Encrypt=true;TrustServerCertificate=true;MultipleActiveResultSets=false"
  },

  // Cartella delle chiavi che cifrano il cookie di autenticazione. Deve stare FUORI dalla
  // cartella di pubblicazione, altrimenti un deploy la cancella e rimanda tutti al login.
  // L'account dell'application pool deve avere permesso di modifica.
  "DataProtection": {
    "KeyPath": "C:\ProgramData\MesDataManager\keys"
  },

  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          // Anche i log stanno fuori dalla cartella di pubblicazione, per sopravvivere al
          // deploy. L'account dell'application pool deve avere permesso di modifica.
          "path": "C:\ProgramData\MesDataManager\logs\mesdatamanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
