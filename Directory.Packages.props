<Project>
  <!--
    Central Package Management: le versioni dei pacchetti si governano solo da qui.
    Verificate con "dotnet list package" in modalita' outdated: alla data dell'ultima
    revisione non risultavano aggiornamenti per i pacchetti effettivamente usati.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!--
      Serve al client del servizio di diagnostica: IHttpClientFactory governa la durata dei
      messaggi e il ricircolo delle connessioni, che un HttpClient tenuto a mano sbaglia.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageVersion Include="MudBlazor" Version="9.9.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
  <!--
    Solo per il progetto di test. SQLite in memoria e' un provider relazionale vero: le
    regole del servizio si verificano sullo stesso percorso di codice che usa SQL Server,
    senza dipendere da un database di sviluppo.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
