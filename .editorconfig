# Convenzioni di scrittura del codice, valide per Visual Studio, VS Code, Rider e
# "dotnet format": vivono qui e non nelle impostazioni dell'editor, cosi' non dipendono da
# chi apre il progetto.
#
# Le regole descrivono come il codice e' GIA' scritto: servono a mantenerlo coerente, non a
# imporre uno stile nuovo. Directory.Build.props attiva EnforceCodeStyleInBuild, quindi
# quelle marcate "warning" compaiono in compilazione.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# In Markdown due spazi a fine riga sono un ritorno a capo voluto.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{csproj,props,targets,json,resx,yml,yaml}]
indent_size = 2

[*.{cs,razor}]
indent_size = 4

# ------------------------------------------------------------------ direttive using
[*.cs]
# System per primo, gruppi separati da una riga vuota: e' la disposizione usata in tutti i file.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:warning

# ------------------------------------------------------------------ struttura
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Parentesi graffe sempre, anche su una sola istruzione: un'aggiunta successiva dentro un if
# senza graffe e' un errore che il compilatore non vede.
csharp_prefer_braces = true:warning

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_method_group_conversion = true:silent

# ------------------------------------------------------------------ preferenze di espressione
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_expression_bodied_accessors = when_on_single_line:silent
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_collection_expression = true:suggestion
csharp_style_prefer_primary_constructors = true:silent
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# Qualificare con this. non aggiunge informazione: il prefisso _ distingue gia' i campi.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ------------------------------------------------------------------ nomi
# Campi di istanza privati con prefisso _, campi statici e costanti in PascalCase.
# L'ordine conta: la prima regola che corrisponde vince.
dotnet_naming_rule.costanti.symbols = simboli_costanti
dotnet_naming_rule.costanti.style = pascal
dotnet_naming_rule.costanti.severity = suggestion

dotnet_naming_rule.campi_statici.symbols = simboli_campi_statici
dotnet_naming_rule.campi_statici.style = pascal
dotnet_naming_rule.campi_statici.severity = suggestion

dotnet_naming_rule.campi_privati.symbols = simboli_campi_privati
dotnet_naming_rule.campi_privati.style = underscore_camel
dotnet_naming_rule.campi_privati.severity = suggestion

dotnet_naming_rule.membri_pubblici.symbols = simboli_membri_pubblici
dotnet_naming_rule.membri_pubblici.style = pascal
dotnet_naming_rule.membri_pubblici.severity = suggestion

dotnet_naming_symbols.simboli_costanti.applicable_kinds = field
dotnet_naming_symbols.simboli_costanti.applicable_accessibilities = *
dotnet_naming_symbols.simboli_costanti.required_modifiers = const

dotnet_naming_symbols.simboli_campi_statici.applicable_kinds = field
dotnet_naming_symbols.simboli_campi_statici.applicable_accessibilities = private, internal
dotnet_naming_symbols.simboli_campi_statici.required_modifiers = static

dotnet_naming_symbols.simboli_campi_privati.applicable_kinds = field
dotnet_naming_symbols.simboli_campi_privati.applicable_accessibilities = private

dotnet_naming_symbols.simboli_membri_pubblici.applicable_kinds = property, method, event, class, struct, interface, enum, delegate
dotnet_naming_symbols.simboli_membri_pubblici.applicable_accessibilities = public, internal, protected

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
